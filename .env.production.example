# Clave criptográfica para firmas JWT (Reemplazar con: openssl rand -hex 32)
SECRET_KEY="REEMPLAZAR_CON_STRING_ALEATORIO_HEX_DE_64_CARACTERES"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Seguridad de Cookies (HTTPS obligatorio vía Caddy en file-node)
COOKIE_SECURE=True
COOKIE_SAMESITE="lax"

# Primer Superusuario Administrador Inicial
FIRST_SUPERUSER_USERNAME="admin"
FIRST_SUPERUSER_EMAIL="admin@esavi.salud.gob.mx"
